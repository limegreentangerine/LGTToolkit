{
    "name": "limegreentangerine/lgt-toolkit",
    "description": "LGT tools and defaults for Concrete CMS",
    "type": "concrete5-package",
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "LgtToolkit\\": "src/"
        }
    },
    "autoload-dev": {
		"psr-4": {
			"LgtToolkit\\Tests\\": "tests/"
		}
	},
    "authors": [
        {
            "name": "Lee Jones",
            "email": "prolific.jones82@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
		"phpunit/phpunit": "^11",
		"concrete5/core": "^9.2",
		"friendsofphp/php-cs-fixer": "^3.95"
	},
    "config": {
        "allow-plugins": {
            "mlocati/composer-patcher": true
        }
    }
}
