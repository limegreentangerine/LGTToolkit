{
	"name": "limegreentangerine/lgt_toolkit",
	"description": "LGT tools and defaults for Concrete CMS",
	"type": "concrete5-package",
	"license": "proprietary",
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"LgtToolkit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"LgtToolkit\\Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "Lee Jones",
			"email": "prolific.jones82@gmail.com"
		},
		{
			"name": "David Hendy",
			"email": "david@limegreentangerine.co.uk"
		}
	],
	"require-dev": {
		"php": "^8.4",
		"phpunit/phpunit": "^11",
		"concrete5/core": "^9.2",
		"friendsofphp/php-cs-fixer": "^3.95"
	},
	"config": {
		"allow-plugins": {
			"mlocati/composer-patcher": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"test-coverage": "phpunit --coverage-text",
		"format:php": "php-cs-fixer fix",
		"format:php:check": "php-cs-fixer check --diff",
		"format:js": "npx prettier --write .",
		"format:js:check": "npx prettier --check .",
		"format": [
			"@format:php",
			"@format:js"
		],
		"format:check": [
			"@format:php:check",
			"@format:js:check"
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "/Users/leejones/Development/Composer/class_kit",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"limegreentangerine/class_kit": "@dev",
		"php-debugbar/php-debugbar": "^3.8"
	}
}
