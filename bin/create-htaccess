#!/usr/bin/env php
<?php

declare(strict_types=1);

if (!isset($_composer_autoload_path)) {
    fwrite(STDERR, "This command must be run through Composer.\n");
    exit(1);
}

$filename = '.htaccess';
$projectRoot = dirname($_composer_autoload_path);
$destination = $projectRoot . '/../public/' . $filename;

if (file_exists($destination)) {
    echo "Skipped (already exists): " . basename($filename) . PHP_EOL;
    exit(0);
}

$contents = <<<'HTACCESS'
# -- concrete urls start --
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME}/index.html !-f
	RewriteCond %{REQUEST_FILENAME}/index.php !-f
	RewriteRule . index.php [L]
</IfModule>
# -- concrete urls end --

HTACCESS;

if (file_put_contents($destination, $contents) === false) {
    fwrite(STDERR, "Failed to create: " . basename($filename) . PHP_EOL);
    exit(1);
}

echo "Created: " . basename($filename) . PHP_EOL;
