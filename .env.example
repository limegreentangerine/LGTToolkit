# LGT Toolkit support tickets — add these to the site's root .env file
# Site key from the helpdesk portal (sent privately — never commit it)
LGT_SUPPORT_API_KEY=
# Optional: only set if told to use a different portal address
LGT_SUPPORT_URL=
# Optional: set to true to allow tickets from staging/dev (subjects are prefixed)
LGT_SUPPORT_ENABLED_NON_PRODUCTION=
# Optional: shown to users if a ticket can't be delivered
LGT_SUPPORT_FALLBACK_EMAIL=
